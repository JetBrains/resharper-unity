<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <config>
        <add key="repositoryPath" value="Packages" />
        <add key="remoteCacheUrl" value="https://ultimate-bazel-cache-http.labs.jb.gg/" />
    </config>

    <packageSources>
        <add key="dotnet_build_space"
             value="https://cache-redirector.jetbrains.com/nuget-build/v3/index.json"
             protocolVersion="3" />
    </packageSources>

    <disabledPackageSources>
        <clear />
    </disabledPackageSources>

    <fallbackPackageFolders>
        <clear />
    </fallbackPackageFolders>
</configuration>